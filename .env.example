PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/handwritten-exam
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

JWT_SECRET=change-this-to-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Firebase Auth (mobile student login) — Admin SDK must match the SAME Firebase project as ellc-mobile (.env EXPO_PUBLIC_FIREBASE_*).
# Firebase Console → Project settings → Service accounts → Generate new private key → JSON file:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# private_key from JSON: ONE line in .env with escaped newlines, e.g. -----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
# Do not wrap in extra quotes unless your whole value is quoted; avoid pasting real line breaks inside the value.
FIREBASE_PRIVATE_KEY=

# Google Sign-In web client ID. Never commit the OAuth client secret JSON.
GOOGLE_CLIENT_ID=

UPLOAD_DIR=uploads

# Bootstrap users (created if missing)
# ADMIN_EMAIL=admin@questnu.bd
# ADMIN_PASSWORD=changeme123
# SEED_INSTRUCTOR_EMAIL=instructor@questnu.bd
# SEED_INSTRUCTOR_PASSWORD=changeme123
